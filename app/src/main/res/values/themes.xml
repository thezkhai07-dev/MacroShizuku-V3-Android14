<resources>
    <style name="Theme.MacroShizuku" parent="Theme.Material3.Dark.NoActionBar">
        <item name="materialButtonStyle">@style/Widget.MacroShizuku.Button</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#070A18</item>
        <item name="android:navigationBarColor">#080B1B</item>
        <item name="android:windowBackground">#0B1020</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#9BDFFF</item>
        <item name="colorPrimary">#8AD8FF</item>
        <item name="colorOnPrimary">#071426</item>
        <item name="colorSecondary">#B6A2FF</item>
        <item name="colorOnSecondary">#17102D</item>
        <item name="colorSurface">#17213A</item>
        <item name="colorOnSurface">#F4F7FF</item>
    </style>
    <style name="Widget.MacroShizuku.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">#243B5B</item>
        <item name="strokeColor">#405879</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">#F5FAFF</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>