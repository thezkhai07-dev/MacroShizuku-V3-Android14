<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#050713" android:centerColor="#0A1025" android:endColor="#08091A"/>
        </shape>
    </item>
    <item android:gravity="top|end" android:width="340dp" android:height="340dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="210dp" android:centerColor="#554C8DFF" android:endColor="#004C8DFF"/>
        </shape>
    </item>
    <item android:gravity="bottom|start" android:width="300dp" android:height="300dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="190dp" android:centerColor="#493E48C9" android:endColor="#003E48C9"/>
        </shape>
    </item>
    <item android:gravity="center" android:width="220dp" android:height="220dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="150dp" android:centerColor="#1825B9C8" android:endColor="#0025B9C8"/>
        </shape>
    </item>
</layer-list>