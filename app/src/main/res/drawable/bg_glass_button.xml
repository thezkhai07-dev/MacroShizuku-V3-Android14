<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#8869E8FF">
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="135" android:startColor="#E53B79B0" android:centerColor="#D1265688" android:endColor="#ED102D52"/>
                    <corners android:radius="18dp"/>
                    <stroke android:width="1dp" android:color="#D66DEBFF"/>
                </shape>
            </item>
            <item android:left="1dp" android:top="3dp" android:right="1dp" android:bottom="18dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#75FFFFFF" android:centerColor="#35BDEFFF" android:endColor="#00FFFFFF"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <stroke android:width="1dp" android:color="#4FEAFCFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>