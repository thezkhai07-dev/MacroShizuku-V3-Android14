<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#445AE7FF">
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="135" android:startColor="#8A294D70" android:centerColor="#76203C5C" android:endColor="#900B1D34"/>
                    <corners android:radius="18dp"/>
                    <stroke android:width="1dp" android:color="#555AE7FF"/>
                </shape>
            </item>
            <item android:left="2dp" android:top="4dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp"/>
                    <stroke android:width="1dp" android:color="#286FEAFF"/>
                </shape>
            </item>
            <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#0EFFFFFF" android:centerColor="#04FFFFFF" android:endColor="#00FFFFFF"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp"/>
                    <stroke android:width="1dp" android:color="#14FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>