<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#665AE7FF">
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="135" android:startColor="#D9366F9F" android:centerColor="#D1234F7A" android:endColor="#E90D294B"/>
                    <corners android:radius="18dp"/>
                    <stroke android:width="1dp" android:color="#875AE7FF"/>
                </shape>
            </item>
            <item android:left="2dp" android:top="4dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp"/>
                    <stroke android:width="1dp" android:color="#556FEAFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>