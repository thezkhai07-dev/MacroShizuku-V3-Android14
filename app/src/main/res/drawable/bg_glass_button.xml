<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#665AE7FF">
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="135" android:startColor="#D9366F9F" android:centerColor="#D1234F7A" android:endColor="#E90D294B"/>
                    <corners android:radius="18dp"/>
                    <stroke android:width="1dp" android:color="#875AE7FF"/>
                </shape>
            </item>
            <item android:left="2dp" android:top="4dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp"/>
                    <stroke android:width="1dp" android:color="#556FEAFF"/>
                </shape>
            </item>
            <!-- Subtle white rim gives the corners a polished glass reflection. -->
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp"/>
                    <stroke android:width="1dp" android:color="#55FFFFFF"/>
                </shape>
            </item>
            <!-- A narrow highlight along the upper edge; the button face stays dark. -->
            <item android:left="9dp" android:top="1dp" android:right="9dp" android:height="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#70FFFFFF" android:endColor="#00FFFFFF"/>
                    <corners android:radius="2dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>