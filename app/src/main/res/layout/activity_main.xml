<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B1020" android:fillViewport="true">
    <LinearLayout android:orientation="vertical" android:padding="18dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="MACRO SHIZUKU" android:textColor="#F4F7FF"
            android:textSize="27sp" android:textStyle="bold" android:letterSpacing="0.06"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="AUTOMATION • MULTI MACRO • ANDROID 14+"
            android:textColor="#42D9F5" android:textSize="11sp" android:textStyle="bold"
            android:paddingBottom="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="vertical" android:padding="14dp"
            android:background="@drawable/bg_panel" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="THIẾT LẬP HỆ THỐNG" android:textColor="#AFC0E2" android:textStyle="bold" android:textSize="13sp" android:paddingBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/shizuku" android:text="1. Cấp quyền Shizuku" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/overlay" android:text="2. Cấp quyền cửa sổ nổi" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/accessibility" android:text="3. Bật Accessibility" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:padding="14dp" android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="PHÍM TẮT TOÀN HỆ THỐNG" android:textColor="#AFC0E2" android:textStyle="bold" android:textSize="13sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/hotkeyEnabled" android:text="Bật phím tắt âm lượng" android:textColor="#F4F7FF" android:buttonTint="#42D9F5" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Volume Up: chạy macro đã chọn một lần\nVolume Down: dừng tất cả (khi ghi: kết thúc ghi)" android:textColor="#AFC0E2" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/hotkeyMacro" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/saveHotkey" android:text="Lưu phím tắt" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:padding="14dp" android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="TẠO MACRO" android:textColor="#AFC0E2" android:textStyle="bold" android:textSize="13sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/name" android:hint="Tên macro mới" android:textColor="#FFFFFF" android:textColorHint="#8292B2" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/speedText" android:text="Tốc độ 1.00x" android:textColor="#F4F7FF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <SeekBar android:id="@+id/speed" android:max="400" android:progress="100" android:progressTint="#42D9F5" android:thumbTint="#42D9F5" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/loops" android:entries="@array/loops" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Lưu ý: Ghi chạm trên Android 14 có thể chặn thao tác trên ứng dụng đích trong lúc ghi." android:textColor="#F6C66A" android:textSize="12sp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/record" android:text="● GHI" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <Button android:id="@+id/stop" android:text="■ LƯU" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:padding="14dp" android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="TÙY CHỈNH NÚT NỔI" android:textColor="#AFC0E2" android:textStyle="bold" android:textSize="13sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/floatSizeText" android:text="Kích thước: 72 dp" android:textColor="#F4F7FF" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <SeekBar android:id="@+id/floatSize" android:max="80" android:progress="24" android:progressTint="#42D9F5" android:thumbTint="#42D9F5" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/floatAlphaText" android:text="Độ trong suốt: 85%" android:textColor="#F4F7FF" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <SeekBar android:id="@+id/floatAlpha" android:max="100" android:progress="85" android:progressTint="#42D9F5" android:thumbTint="#42D9F5" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Áp dụng cho nút macro hình tròn và nút STOP ALL nổi." android:textColor="#8292B2" android:textSize="11sp" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button android:id="@+id/floatBtn" android:text="Hiện / làm mới nút nổi" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/exportBtn" android:text="Xuất backup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <Button android:id="@+id/importBtn" android:text="Nhập backup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        </LinearLayout>
        <Button android:id="@+id/stopAll" android:text="⛔ STOP ALL" android:textColor="#FFFFFF" android:backgroundTint="#C83E5A" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="MACRO ĐÃ LƯU" android:textColor="#F4F7FF" android:textStyle="bold" android:textSize="18sp" android:paddingTop="20dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/macroList" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Macro Shizuku • V3" android:textColor="#637493" android:textSize="11sp" android:gravity="center" android:paddingTop="20dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>